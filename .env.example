# ---------------------------------------------------------------------------
# STUDYMATE AI — environment variables
# Copy this file to .env and fill in the values you have.
# ---------------------------------------------------------------------------

# SQLite database. The path is resolved relative to prisma/schema.prisma.
DATABASE_URL="file:../data/studymate.db"

# Required for live AI. Create a key at https://aistudio.google.com/apikey
# Without a key the app runs in Demo Mode: curated sample workspace only,
# clearly labelled everywhere. Arbitrary files require a live key.
GEMINI_API_KEY=""

# Optional model overrides. Defaults are current stable Gemini models.
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Optional: Gemini 3 thinking level ("minimal", "low", "medium", "high").
# "low" keeps structured note/quiz responses fast. Set "default" to omit it.
GEMINI_THINKING_LEVEL="low"

# Optional: embedding dimensions (default 768; supported 128-3072).
# Lower dimensions are cheaper and fast enough for a single-document demo.
GEMINI_EMBEDDING_DIMENSIONS="768"

# Optional: force demo mode even if a key exists ("true" / "false").
# Useful for judges who want to see the curated demo without API spend.
FORCE_DEMO_MODE="false"

# Optional: the public URL, used in README/deployment only.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
